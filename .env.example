# SCOUT
WHOISFREAKS_API_KEY=your_key_here
CATCHDOMS_API_KEY=
APIFY_API_TOKEN=

# SENTINEL
DATAFORSEO_LOGIN=your_login
DATAFORSEO_PASSWORD=your_password
GOOGLE_CSE_API_KEY=your_key
GOOGLE_CSE_CX=your_cx_id

# SPECTRE
GITHUB_TOKEN=your_github_token
REDDIT_CLIENT_ID=your_client_id
REDDIT_CLIENT_SECRET=your_client_secret
REDDIT_USER_AGENT=DomainHunter/1.0

# ORACLE + SPECTRE
ANTHROPIC_API_KEY=your_anthropic_key

# CLASSIFIER (Sprint 3 — DeepSeek)
DEEPSEEK_API_KEY=sk-your-key-here

# NameBright / DropCatch (OAuth2 - shared credentials)
# Setup: https://my.namebright.com/my-account/api-management
# Format: accountname:appname
DROPCATCH_CLIENT_ID=
DROPCATCH_API_SECRET=

# Post-catch DNS defaults
POST_CATCH_NAMESERVERS=ns1.cloudflare.com,ns2.cloudflare.com
POST_CATCH_LANDING_IP=

# INFRASTRUCTURE
DATABASE_URL=sqlite:///domainhunter.db
SLACK_WEBHOOK_URL=
ALERT_EMAIL=

# NOTIFICATIONS (travel-proof alerts)
# Email via Resend API
NOTIFY_EMAIL_TO=
RESEND_API_KEY=
# Push notifications via ntfy.sh (free, no signup)
# Install ntfy app on phone, subscribe to your topic
NOTIFY_NTFY_TOPIC=

# AUTHORITY GATE (3-Layer Domain Authority Verification)
# Free API key from https://www.domcop.com/openpagerank/
OPENPAGERANK_API_KEY=your_opr_key_here
# Set to false to disable authority gate in pipeline
AUTHORITY_GATE_ENABLED=true
# Set to true to skip Layer 2 paid checks (DataForSEO)
AUTHORITY_GATE_SKIP_PAID=false

# PIPELINE SETTINGS
MAX_SCOUT_CANDIDATES=500
MAX_SENTINEL_SURVIVORS=60
MAX_ARCHIVIST_VERIFIED=15
MAX_SPECTRE_SCORED=5
MIN_DA_THRESHOLD=25
MAX_SPAM_SCORE=20.0
MIN_ARCHIVE_YEARS=3.0
MIN_REFERRING_DOMAINS=100
MIN_BRANDED_ANCHOR_PCT=40.0
