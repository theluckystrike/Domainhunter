  "verification_steps": {
    "step_1_verify_etv": {
      "order": 1,
      "description": "Confirm ETV via DataForSEO API call",
      "cost_usd": 0.01,
      "pass_criteria": "API ETV within 20% of pipeline alert ETV",
      "fail_criteria": "API ETV is 50%+ lower than alert -- abort or downgrade tier",
      "command": "curl -s -X POST -u 'support@zovo.one:f9f943da5a9ef3e9' -H 'Content-Type: application/json' -d '[{\"target\":\"DOMAIN\",\"limit\":1,\"language_code\":\"en\",\"location_code\":2840}]' 'https://api.dataforseo.com/v3/dataforseo_labs/google/domain_rank_overview/live' | python3 -m json.tool"
    },
    "step_2_check_whois": {
      "order": 2,
      "description": "WHOIS lookup for domain status and expiry",
      "cost_usd": 0,
      "command": "whois DOMAIN",
      "green_flags": [
        "pendingDelete",
        "redemptionPeriod",
        "serverHold",
        "expiry date in the past or within 45 days"
      ],
      "red_flags": [
        "clientDeleteProhibited",
        "all four client*Prohibited locks active",
        "expiry date 6+ months out",
        "registrant is major corporation or government"
      ]
    },
    "step_3_check_http": {
      "order": 3,
      "description": "HTTP HEAD request to check if site is live",
      "cost_usd": 0,
      "command": "curl -sI https://DOMAIN | head -20",
      "green_signals": [
        "connection refused",
        "connection timeout",
        "NXDOMAIN",
        "200 with parking/expired page"
      ],
      "red_signals": [
        "200 with real content",
        "403 with WAF (Sucuri, Cloudflare)",
        "301 to active business"
      ]
    },
    "step_4_entity_verification": {
      "order": 4,
      "description": "The Olive.com Gate -- verify domain is NOT an active business",
      "cost_usd": 0,
      "lesson_source": "olive.com -- $2,923/mo ETV, turned out to be active car warranty business",
      "checks": [
        "Google: site:DOMAIN -- check indexed pages and content",
        "Google: \"DOMAIN\" -- check news, LinkedIn, reviews",
        "dig MX DOMAIN +short -- active email = active business",
        "dig TXT DOMAIN +short -- SPF with services = active business"
      ],
      "go_verdicts": [
        "defunct startup (Crunchbase closed)",
        "parked by domain investor",
        "nonprofit that lost funding",
        "site is completely offline with no DNS"
      ],
      "nogo_verdicts": [
        "active business with customers",
        "government or educational institution",
        "active business in shutdown process (monitor only)"
      ]
    }
  },

  "decision_matrix": {
    "go_condition": "ALL FOUR must be TRUE: ETV verified AND WHOIS dropping AND HTTP down AND NOT active business",
    "nogo_condition": "ANY ONE of the four fails = NO GO",
    "hard_nogo_overrides": [
      ".gov / .edu / .mil domain",
      "trademarked by major corporation",
      "active litigation involving the domain",
      "budget remaining < max bid amount",
      "3+ bidders already visible on DropCatch"
    ],
    "caution_flags": [
      "domain was a well-known brand (expect auction competition)",
      "domain has been previously auctioned and re-dropped",
      "ETV concentrated in 1-2 keywords (fragile)"
    ]
  },

  "post_acquisition": {
    "immediate_1hr": [
      "Verify domain in registrar account",
      "Point DNS to Cloudflare",
      "Set up basic redirect or landing page to preserve link equity"
    ],
    "within_24hr": [
      "Run DataForSEO ranked keywords report ($0.01)",
      "Check Wayback Machine for last live content",
      "Identify top 5 ranking keywords and landing pages",
      "Decide: redirect to existing property OR build standalone"
    ],
    "within_7days": [
      "Deploy content matching historical niche",
      "Set up Google Search Console",
      "Submit sitemap",
      "Monitor indexing"
    ],
    "within_30days": [
      "Evaluate actual organic traffic vs projected ETV",
      "Decide long-term strategy (keep, redirect, flip)",
      "Update budget tracker"
    ]
  },

  "logging": {
