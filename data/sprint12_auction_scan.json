  "godaddy_marketplace_systems_explained": {
    "overview": "GoDaddy operates 4 distinct marketplace systems. Sprint 10 confused Aftermarket/Premium listings ($1,540+) with Closeout auctions ($5-$11). These are completely different systems with different pricing, URLs, and mechanics.",
    "systems": {
      "1_standard_registration": {
        "what": "Brand new domain registration at retail price ($10-$20/yr for .com)",
        "url": "https://www.godaddy.com/domains",
        "price_range": "$0.99-$20/yr for standard TLDs",
        "how_it_works": "Search for unregistered domains and register them at retail price. No auction involved."
      },
      "2_aftermarket_premium": {
        "what": "Currently registered domains listed for sale by their owners through Afternic (GoDaddy subsidiary). THIS IS WHAT SPRINT 10 FOUND.",
        "url": "https://www.afternic.com/ (also surfaces on godaddy.com domain search)",
        "price_range": "$50 to $1,000,000+ (set by domain owner)",
        "how_it_works": "Domain owners list their domains with a Buy Now price and/or Make Offer. GoDaddy distributes these listings across 100+ partner sites. Commission is 15-25%. These are NOT auction deals - they are premium aftermarket prices set by speculators.",
        "key_indicator": "Nameservers pointing to ns1.afternic.com / ns2.afternic.com means the domain is an aftermarket premium listing, NOT an expired auction.",
        "sprint10_error": "Sprint 10 found domains like chapter7bankruptcy.com and flashcardsonline.com on Afternic nameservers and confused their premium asking prices with auction deals. These domains have NEVER been in a closeout or expired auction - they are actively held by investors."
      },
      "3_expired_auctions": {
        "what": "Domains registered at GoDaddy that the owner failed to renew. Listed as expired domain auctions 26 days after expiration.",
        "url": "https://auctions.godaddy.com/beta (requires $4.99/yr GoDaddy Auctions membership)",
        "price_range": "Starting bid $1 (can go to thousands for premium names)",
        "how_it_works": "10-day traditional bid-style auction. Multiple bidders compete. Original owner can still renew during this period (canceling the auction with full refund to bidder). Domain keeps its age/WHOIS history if purchased here.",
        "inventory_file": "https://inventory.auctions.godaddy.com/ (download all_expiring_auctions.json.zip)",
        "volume": "~62,463 expired domains ending per day, ~4,000+ aged domains (10+ years) entering auction daily"
      },
      "4_closeout_auctions": {
        "what": "The LAST CHANCE to buy expired domains that received ZERO bids during the 10-day expired auction. This is where the real $5-$11 deals are.",
        "url": "https://auctions.godaddy.com/beta (filter by Closeout type)",
        "price_range": "$5-$11 (reverse auction, price drops daily)",
        "pricing_schedule": {
          "day_1": "$11",
          "day_2": "$10",
          "day_3": "$8",
          "day_4": "$6",
          "day_5": "$5",
          "after_day_5": "Domain is released back to registry for standard registration"
        },
        "how_it_works": "Buy Now format (no bidding). First person to click Buy wins. Price decreases each day. Domain keeps its age/WHOIS creation date. You also pay standard registration fee on top of closeout price.",
        "inventory_file": "https://inventory.auctions.godaddy.com/ (download closeout_listings.json.zip or closeouts.xml.zip)",
        "volume": "~256,810 closeout domains available at any time",
        "key_facts": [
          "Over 99% of closeout domains are low quality - careful filtering required",
          "Good names get grabbed at $11 on day 1 - waiting for $5 means only dregs remain",
          "Domains with .edu/.gov backlinks are the holy grail finds",
          "Need GoDaddy Auctions membership ($4.99/yr) to purchase",
          "Transfer to your account takes 7-10 days after redemption period closes",
          "Original owner can still renew during redemption, canceling your purchase with full refund"
        ]
      }
    },
    "critical_distinction": "When you search for a domain on godaddy.com and see a price like $1,540 or $2,999, that is an AFTERMARKET PREMIUM price set by the current owner through Afternic. It is NOT a closeout price. Real closeout prices are $5-$11 and are only visible through the GoDaddy Auctions interface or inventory files."
  },

